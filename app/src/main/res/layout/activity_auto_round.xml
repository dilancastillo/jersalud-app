<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAutoRound"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBarAuto"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color_primary"
        android:theme="@style/ThemeOverlay.MaterialComponents.ActionBar"
        app:title="Ronda automática de educación"
        app:titleCentered="true"
        app:titleTextAppearance="@style/ToolbarTitleLarge"
        app:titleTextColor="@color/white"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="56dp">

        <TextView
            android:id="@+id/tvRoundTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:textAlignment="center"
            android:text="Ronda automática de educación"
            android:textSize="45sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:layout_marginStart="24dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_refresh"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tvRoundStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:text="Paso 1 de 4"
                android:textSize="35sp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:layout_marginStart="24dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_ubication"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tvRunningHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ronda en curso"
                android:textStyle="bold"
                android:textSize="35sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/label_tvRunningState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:layout_marginStart="24dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_road"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tvRunningState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ronda en curso"
                android:textStyle="bold"
                android:textSize="35sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/stepTopic"
                    app:cardBackgroundColor="@color/text_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#3454a4"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1. Selecciona el tema de educación"
                            android:textStyle="bold"
                            android:textSize="35sp" />

                        <LinearLayout
                            android:id="@+id/layoutTopicList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
<!--dos-->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/stepBeds"
                    app:cardBackgroundColor="@color/text_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#3454a4"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2. Selecciona las camas a visitar"
                            android:textStyle="bold"
                            android:textSize="35sp" />

                        <TextView
                            android:id="@+id/tvBedsFloor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Área / piso:"
                            android:textSize="35sp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBedsSelectAll"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Seleccionar todas"
                                android:textSize="35sp"
                                app:backgroundTint="@color/color_primary"/>

                            <Space
                                android:layout_width="12dp"
                                android:layout_height="0dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBedsClear"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Limpiar selección"
                                android:textSize="35sp"
                                app:backgroundTint="@color/color_primary"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutBedList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp"
                            app:buttonTint="@color/color_primary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
<!--tres-->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/stepRules"
                    app:cardBackgroundColor="@color/text_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#6454a4"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="3. Ajusta las reglas de la ronda"
                            android:textStyle="bold"
                            android:textSize="40sp"/>

                        <CheckBox
                            android:id="@+id/cbAskAvailability"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Preguntar si es un buen momento antes de iniciar"
                            android:textSize="50sp"
                            android:button="@drawable/radio_big"
                            app:buttonTint="@color/color_primary"/>

                        <CheckBox
                            android:id="@+id/cbSkipIfNoResponse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Saltar cama si no hay respuesta"
                            android:textSize="50sp"
                            android:button="@drawable/radio_big"
                            app:buttonTint="@color/color_primary"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tiempo de espera (segundos):"
                                android:textSize="50sp"/>

                            <EditText
                                android:id="@+id/etSkipSeconds"
                                android:layout_width="64dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:inputType="number"
                                android:gravity="center"
                                android:textSize="35sp"/>
                        </LinearLayout>

                        <CheckBox
                            android:id="@+id/cbReturnToNursing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Al terminar, regresar a Enfermería"
                            android:textSize="50sp"
                            android:button="@drawable/radio_big"
                            app:buttonTint="@color/color_primary"/>

                        <CheckBox
                            android:id="@+id/cbAutoRepeatIfLow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Repetir explicación automáticamente si la comprensión es baja"
                            android:textSize="50sp"
                            android:button="@drawable/radio_big"
                            app:buttonTint="@color/color_primary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
<!--cuatro-->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/stepSummary"
                    app:cardBackgroundColor="@color/text_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#6454a4"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="4. Revisa la configuración"
                            android:textStyle="bold"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/tvSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="40sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
<!--quinto-->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/panelRunning"
                    app:cardBackgroundColor="#F5F5F5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">


<!--                        <TextView-->
<!--                            android:id="@+id/tvRunningState"-->
<!--                            android:layout_width="match_parent"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_marginTop="4dp"-->
<!--                            android:textSize="35sp"-->
<!--                            android:text="Estado..." />-->

                        <LinearLayout
                            android:id="@+id/panelAvailability"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvAvailabilityQuestion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="¿Podemos hablar ahora?"
                                android:textSize="40sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAvailYes"
                                    style="@style/Widget.MaterialComponents.Button"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Sí, ahora"
                                    android:textSize="35sp"
                                    app:backgroundTint="@color/color_primary"/>

                                <Space
                                    android:layout_width="12dp"
                                    android:layout_height="0dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAvailNo"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textSize="35sp"
                                    android:text="No es buen momento"
                                    android:textColor="@color/color_primary"/>
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/panelComprehension"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="16dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="center"
                                android:text="¿Qué tanto se entendió la explicación?"
                                android:textSize="35sp" />

                            <RadioGroup
                                android:id="@+id/rgComp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:layout_marginTop="8dp"
                                android:paddingEnd="15dp"
                                android:paddingStart="15dp">

                                <RadioButton
                                    android:id="@+id/rbCompFull"
                                    android:layout_width="300dp"
                                    android:layout_height="300dp"
                                    android:button="@null"
                                    android:background="@drawable/img_selected_understood"
                                    android:gravity="center"
                                    android:textSize="30sp"
                                    android:layout_marginEnd="28dp"
                                    android:layout_marginStart="28dp"
                                    android:elevation="4dp"/>

                                <RadioButton
                                    android:id="@+id/rbCompPartial"
                                    android:layout_width="300dp"
                                    android:layout_height="300dp"
                                    android:button="@null"
                                    android:background="@drawable/img_selected_neutral"
                                    android:gravity="center"
                                    android:textSize="30sp"
                                    android:layout_marginEnd="28dp"
                                    android:layout_marginStart="28dp"/>

                                <RadioButton
                                    android:id="@+id/rbCompNone"
                                    android:layout_width="300dp"
                                    android:layout_height="300dp"
                                    android:button="@null"
                                    android:background="@drawable/img_selected_notunderstand"
                                    android:gravity="center"
                                    android:textSize="30sp"
                                    android:layout_marginEnd="28dp"
                                    android:layout_marginStart="28dp"/>
                            </RadioGroup>

<!--                            <TextView-->
<!--                                android:layout_width="match_parent"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:layout_marginTop="8dp"-->
<!--                                android:text="Notas o dudas (opcional):"-->
<!--                                android:textSize="35sp"/>-->

<!--                            <CheckBox-->
<!--                                android:id="@+id/cbCompReplay"-->
<!--                                android:layout_width="match_parent"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:layout_marginTop="8dp"-->
<!--                                android:textSize="40sp"-->
<!--                                android:button="@drawable/radio_big"-->
<!--                                android:text="Repetir explicación si comprensión es baja" />-->

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCompSave"
                                style="@style/Widget.MaterialComponents.Button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Guardar comprensión"
                                android:textSize="35sp"
                                app:backgroundTint="@color/color_primary"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevStep"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Atrás"
                android:textSize="35sp"
                android:textColor="@color/color_primary"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextStep"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Siguiente"
                android:textSize="35sp"
                app:backgroundTint="@color/color_primary" />/>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>