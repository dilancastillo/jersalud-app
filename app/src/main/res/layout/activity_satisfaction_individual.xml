<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSatInd"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBarSatInd"
        android:layout_width="match_parent"
        app:titleTextColor="@color/white"
        android:layout_height="56dp"
        android:background="@color/color_primary"
        android:theme="@style/ThemeOverlay.MaterialComponents.ActionBar"
        app:title="Encuesta de Satisfacción individual"
        app:titleTextAppearance="@style/ToolbarTitleLarge"
        app:titleCentered="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="56dp">

        <TextView
            android:id="@+id/tvSatIndTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Sesión individual de satisfacción"
            android:textSize="45sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/containerSatInd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/stepSatIndBed"
                    app:cardBackgroundColor="@color/text_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#6454a4"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvSatIndFloor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Seleccione la cama para la sesión"
                            android:textSize="40sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rgSatIndBeds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
<!--segunda-->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/panelSatIndSurvey"
                    app:cardBackgroundColor="@color/text_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#3454a4"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvSatIndQuestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pregunta de satisfacción"
                            android:textSize="40sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rgSatIndOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSatIndVoice"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Responder por voz"
                                android:textColor="@color/color_primary"
                                android:textSize="30sp"/>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSatIndNextQuestion"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:textColor="@color/white"
                                android:backgroundTint="@color/color_primary"
                                android:textSize="30sp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="Siguiente" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/white"
                android:backgroundTint="@color/color_primary"
                android:id="@+id/btnSatIndGo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:layout_weight="1"
                android:text="Ir a la cama y empezar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSatIndCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textSize="28sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Cancelar"
                android:textColor="@color/color_primary"/>
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>