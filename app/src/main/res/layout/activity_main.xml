<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="0dp"
    tools:context=".ui.MainActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:strokeColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/banner"
            android:paddingBottom="12dp"
            android:paddingTop="12dp">
            <!-- inicio de codigo-->
            <!-- PANEL LATERAL IZQUIERDO -->
            <LinearLayout
                android:id="@+id/topMenuBar"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@android:color/transparent"
                android:elevation="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/btnMenu"
                app:layout_constraintTop_toTopOf="@id/btnMenu">

                <View
                    android:id="@+id/dividerVertical"
                    android:layout_width="2dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="8dp"
                    android:background="#FFFFFF"
                    app:layout_constraintStart_toEndOf="@id/btnMenu"
                    app:layout_constraintTop_toTopOf="@id/btnMenu"/>


                <ImageView
                    android:id="@+id/btnTranslate"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_translatewhite"
                    android:layout_marginRight="25dp"
                    android:padding="6dp" />

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_settingwhite"
                    android:layout_marginRight="25dp"
                    android:padding="6dp" />

                <ImageView
                    android:id="@+id/btnBackToBase"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/icon_homewhite"
                    android:layout_marginRight="25dp"
                    android:padding="6dp" />

                <ImageView
                    android:id="@+id/btnExitKiosk"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_closewhite"
                    android:layout_marginRight="25dp"
                    android:padding="6dp"/>

            </LinearLayout>



            <!-- Botón menú (hamburguesa) -->
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="60dp"
                android:padding="6dp"
                android:src="@drawable/icon_menu"
                android:contentDescription="@string/content_description_settings"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/icon_imo"
                android:layout_width="150dp"
                android:layout_height="45dp"
                android:layout_marginEnd="60dp"
                android:src="@drawable/icon_imo"
                android:contentDescription="@string/content_description_settings"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- SCROLLVIEW-->
    <ScrollView
        android:id="@+id/scrollCards"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card bienvenida -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="40dp"
                    android:layout_marginTop="10dp">


                    <LinearLayout
                        android:id="@+id/leftColumn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/rightColumn"
                            android:layout_width="wrap_content"
                            android:layout_height="190dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icon_imo2"
                            android:paddingTop="10dp"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="8dp"
                            android:layout_marginEnd="30dp"
                            app:cardUseCompatPadding="true">

                        <LinearLayout
                            android:id="@+id/welcomeCardContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="30dp"
                            android:background="@drawable/containerstyle"                            >

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/card_welcome_title"
                            android:textSize="29sp"
                            style="@style/CardTitleText2" />

                        <TextView
                            android:id="@+id/textClinic"
                            android:layout_height="wrap_content"
                            android:layout_width="600dp"
                            android:text="@string/card_welcome_body"
                            android:textSize="21sp"
                            style="@style/CardBodyText2" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSpeak"
                            style="@style/ModernSolidButton"
                            android:layout_width="wrap_content"
                            android:layout_height="50sp"
                            android:layout_marginTop="24dp"
                            android:text="@string/btn_speak_with_patient"
                            app:icon="@android:drawable/ic_btn_speak_now"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!--
                    <ImageView
                        android:id="@+id/rightColumn"
                        android:layout_width="400dp"
                        android:layout_height="400dp"
                        android:layout_marginEnd="206dp"
                        android:src="@drawable/icon_pet3"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/leftColumn"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintHorizontal_weight="1" />
                        -->
                </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- GRID -->
            <GridLayout
                android:id="@+id/gridCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:useDefaultMargins="true"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="60dp">



                <!-- SATISFACCION -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSatisfaction"
                    style="@style/ModernCardBase"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="@color/color_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1">

                    <LinearLayout
                        android:layout_marginTop="35sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:id="@+id/imgSatisfaccion"
                            android:src="@drawable/survey"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_marginBottom="15dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/title_satisfaction"
                            style="@style/CardTitleText" />

                        <TextView
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:text="@string/body_satisfaction"
                            style="@style/CardBodyText" />


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- PAIN ROUND -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPainRound"
                    style="@style/ModernCardBase"
                    app:cardBackgroundColor="@color/color_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1">

                    <LinearLayout
                        android:layout_marginTop="35sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:id="@+id/imgDolor"
                            android:src="@drawable/satisfaccion"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_marginBottom="15dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/title_pain_round"
                            style="@style/CardTitleText" />

                        <TextView
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:text="@string/body_pain_round"
                            style="@style/CardBodyText" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- EDUCACION -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnEducation"
                    style="@style/ModernCardBase"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="@color/color_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1">

                    <LinearLayout
                        android:layout_marginTop="35sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:id="@+id/imgEducacion"
                            android:src="@drawable/teaching"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_marginBottom="15dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/title_education"
                            style="@style/CardTitleText" />

                        <TextView
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:text="@string/body_education"
                            style="@style/CardBodyText" />


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ADMISIONES -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnGoAdmis"
                    style="@style/ModernCardBase"
                    app:cardBackgroundColor="@color/color_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1">

                    <LinearLayout
                        android:layout_marginTop="35sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:id="@+id/imgAdmisiones"
                            android:src="@drawable/admisiones"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_marginBottom="15dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/title_admissions"
                            style="@style/CardTitleText" />

                        <TextView
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:text="@string/body_admissions"
                            style="@style/CardBodyText" />


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- HABITACIÓN 302 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnGoHab"
                    style="@style/ModernCardBase"
                    app:cardBackgroundColor="@color/color_primary"
                    android:layout_marginEnd="20dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1">

                    <LinearLayout
                        android:layout_marginTop="35sp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <ImageView
                            android:id="@+id/imghabitacion"
                            android:src="@drawable/bed"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_marginBottom="15dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="@string/title_room_302"
                            style="@style/CardTitleText" />

                        <TextView
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_width="wrap_content"
                            android:text="@string/body_room_302"
                            style="@style/CardBodyText" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
