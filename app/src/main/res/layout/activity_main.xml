<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:padding="24dp"
    tools:context=".ui.MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSettings" />

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="4dp"
        android:contentDescription="@string/content_description_settings"
        android:src="@android:drawable/ic_menu_info_details"
        app:tint="@color/text_gray_body"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageView
        android:id="@+id/btnSettings2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintEnd_toStartOf="@id/btnSettings"
        android:padding="4dp"
        android:contentDescription="@string/content_description_settings"
        android:src="@android:drawable/ic_menu_info_details"
        app:tint="@color/text_gray_body"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/status_connecting"
        android:textSize="16sp"
        android:textColor="@color/text_gray_body"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWelcome"
        style="@style/ModernCardBase"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/card_bg_green_soft"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imgTemiWelcome">

                <TextView
                    android:text="@string/card_welcome_title"
                    style="@style/CardTitleText"
                    android:textSize="24sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="@string/card_welcome_body"
                    style="@style/CardBodyText"
                    android:textSize="16sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeak"
                    style="@style/ModernSolidButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="24dp"
                    android:text="@string/btn_speak_with_patient"
                    app:icon="@android:drawable/ic_btn_speak_now"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgTemiWelcome"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/esbot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <GridLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="true"
        android:alignmentMode="alignBounds"
        app:layout_constraintTop_toBottomOf="@id/cardWelcome"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            style="@style/ModernCardBase"
            app:cardBackgroundColor="@color/card_bg_blue_soft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:text="@string/title_admissions" style="@style/CardTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/body_admissions" style="@style/CardBodyText" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoAdmis"
                    style="@style/ModernSolidButton"
                    android:layout_width="match_parent"
                    android:text="@string/btn_start_route"
                    android:backgroundTint="#4A90E2"/> </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/ModernCardBase"
            app:cardBackgroundColor="@color/card_bg_blue_soft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:text="@string/title_room_302" style="@style/CardTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/body_room_302" style="@style/CardBodyText" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoHab"
                    style="@style/ModernSolidButton"
                    android:layout_width="match_parent"
                    android:text="@string/btn_start_route"
                    android:backgroundTint="#4A90E2"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/ModernCardBase"
            app:cardBackgroundColor="@color/card_bg_purple_soft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:text="@string/title_satisfaction" style="@style/CardTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/body_satisfaction" style="@style/CardBodyText" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSatisfaction"
                    style="@style/ModernSolidButton"
                    android:layout_width="match_parent"
                    android:text="@string/btn_open_survey"
                    android:backgroundTint="#9C27B0"/> </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/ModernCardBase"
            app:cardBackgroundColor="@color/card_bg_orange_soft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:text="@string/title_pain_round" style="@style/CardTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/body_pain_round" style="@style/CardBodyText" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPainRound"
                    style="@style/ModernSolidButton"
                    android:layout_width="match_parent"
                    android:text="@string/btn_start_round"
                    android:backgroundTint="#FF7043"/> </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/ModernCardBase"
            app:cardBackgroundColor="@color/card_bg_orange_soft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:text="@string/title_education" style="@style/CardTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/body_education" style="@style/CardBodyText" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEducation"
                    style="@style/ModernSolidButton"
                    android:layout_width="match_parent"
                    android:text="@string/btn_view_module"
                    android:backgroundTint="#FF7043"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/ModernCardBase"
            app:cardBackgroundColor="@color/card_bg_gray_soft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:text="@string/title_system" style="@style/CardTitleText" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="@string/body_system" style="@style/CardBodyText" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackToBase"
                        style="@style/ModernOutlineButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/btn_go_to_base" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExitKiosk"
                        style="@style/ModernOutlineButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/alert_red_text"
                        app:strokeColor="@color/alert_red_text"
                        android:text="@string/btn_exit_app" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>