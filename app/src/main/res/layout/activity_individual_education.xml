<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollIndEdu"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootIndEdu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvIndTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sesión individual de educación"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIndStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Paso 1 de 2"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/stepIndTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIndTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Selecciona el tema de educación"
                android:textStyle="bold"
                android:textSize="23sp"/>

            <LinearLayout
                android:id="@+id/layoutIndTopicList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stepIndBed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvIndBedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Selecciona la cama del paciente"
                android:textStyle="bold"
                android:textSize="25sp"/>

            <TextView
                android:id="@+id/tvIndBedFloor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Área / piso:"
                android:textSize="20sp"/>

            <RadioGroup
                android:id="@+id/rgIndBedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelIndRunning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvIndRunningHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sesión en curso"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIndRunningState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="20sp" />
                android:text="Estado..." />

            <LinearLayout
                android:id="@+id/panelIndAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvIndAvailabilityQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Podemos hablar ahora?"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnIndAvailYes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/color_primary"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:text="Sí, ahora" />

                    <Button
                        android:id="@+id/btnIndAvailNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/color_primary"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:layout_marginStart="8dp"
                        android:text="No es buen momento" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelIndComprehension"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvIndCompTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Qué tanto se entendió la explicación?"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/rgIndComp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbIndCompFull"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lo entendió bien" />

                    <RadioButton
                        android:id="@+id/rbIndCompPartial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entendió a medias" />

                    <RadioButton
                        android:id="@+id/rbIndCompNone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No lo entendió" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvIndCompNotesLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Notas o dudas (opcional):" />

                <EditText
                    android:id="@+id/etIndCompNotes"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:background="@android:drawable/edit_text" />

                <CheckBox
                    android:id="@+id/cbIndCompReplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Repetir la explicación si la comprensión es baja" />

                <Button
                    android:id="@+id/btnIndCompSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Guardar comprensión" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomIndBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIndPrevStep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/white"
                android:backgroundTint="@color/color_primary"
                android:text="Atrás" />

            <Button
                android:id="@+id/btnIndNextStep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="18sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/white"
                android:backgroundTint="@color/color_primary"
                android:text="Siguiente" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>