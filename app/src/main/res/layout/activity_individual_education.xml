<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollIndEdu"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/rootIndEdu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvIndTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sesión individual de educación"
            android:textAlignment="center"
            android:textSize="30sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_refresh"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/tvIndStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paso 1 de 2"
                android:textSize="30sp" />
        </LinearLayout>
<!--aqui iria icono para tvIndStep -->


        <LinearLayout
            android:id="@+id/stepIndTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIndTopicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Selecciona el tema de educación"
                android:textSize="45sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutIndTopicList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />
        </LinearLayout>
<!--dos-->
        <LinearLayout
            android:id="@+id/stepIndBed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvIndBedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Selecciona la cama del paciente"
                android:textStyle="bold"
                android:textSize="40sp"/>

            <TextView
                android:id="@+id/tvIndBedFloor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Área / piso:"
                android:textSize="35sp"/>

            <RadioGroup
                android:id="@+id/rgIndBedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>
<!--tres-->
        <LinearLayout
            android:id="@+id/panelIndRunning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_topic"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tvIndRunningHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sesión en curso"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#333"/>
            </LinearLayout>
<!--aqui inicia el contenedor-->
                <TextView
                    android:id="@+id/tvIndRunningState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center"
                    android:textSize="30sp"
                    android:background="#F5F5F5"
                    android:text="Estado..." />



            <LinearLayout
                android:id="@+id/panelIndAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvIndAvailabilityQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Podemos hablar ahora?"
                    android:textSize="40sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnIndAvailYes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/color_primary"
                        android:layout_weight="1"
                        android:textSize="30sp"
                        android:text="Sí, ahora" />

                    <Button
                        android:id="@+id/btnIndAvailNo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/color_primary"
                        android:layout_weight="1"
                        android:textSize="30sp"
                        android:layout_marginStart="8dp"
                        android:text="No es buen momento" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelIndComprehension"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:visibility="gone"
                tools:visibility="visible">

<!--                <TextView-->
<!--                    android:id="@+id/tvIndCompTitle"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="¿Qué tanto se entendió la explicación?"-->
<!--                    android:textSize="45sp" />-->

                <RadioGroup
                    android:id="@+id/rgIndComp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="58dp"
                    android:paddingEnd="15dp"
                    android:paddingStart="15dp">

                    <RadioButton
                        android:id="@+id/rbIndCompFull"
                        android:layout_width="300dp"
                        android:layout_height="300dp"
                        android:button="@null"
                        android:background="@drawable/img_selected_understood"
                        android:gravity="center"
                        android:padding="10dp"
                        android:textSize="30sp"
                        android:layout_marginEnd="28dp"
                        android:layout_marginStart="28dp"
                        android:elevation="4dp"/>

                    <RadioButton
                        android:id="@+id/rbIndCompPartial"
                        android:layout_width="300dp"
                        android:layout_height="300dp"
                        android:button="@null"
                        android:background="@drawable/img_selected_neutral"
                        android:gravity="center"
                        android:textSize="30sp"
                        android:layout_marginEnd="28dp"
                        android:layout_marginStart="28dp"/>

                    <RadioButton
                        android:id="@+id/rbIndCompNone"
                        android:layout_width="300dp"
                        android:layout_height="300dp"
                        android:button="@null"
                        android:background="@drawable/img_selected_notunderstand"
                        android:gravity="center"
                        android:textSize="30sp"
                        android:layout_marginEnd="28dp"
                        android:layout_marginStart="28dp"/>
                </RadioGroup>

<!--                <TextView-->
<!--                    android:id="@+id/tvIndCompNotesLabel"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginTop="8dp"-->
<!--                    android:textSize="30sp"-->
<!--                    android:text="Notas o dudas (opcional):" />-->

<!--                <EditText-->
<!--                    android:id="@+id/etIndCompNotes"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="80dp"-->
<!--                    android:inputType="textMultiLine"-->
<!--                    android:gravity="top|start"-->
<!--                    android:background="@android:drawable/edit_text" />-->

<!--                <CheckBox-->
<!--                    android:id="@+id/cbIndCompReplay"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginTop="8dp"-->
<!--                    android:textSize="40sp"-->
<!--                    android:button="@drawable/radio_big"-->
<!--                    android:text="Repetir la explicación si la comprensión es baja" />-->

                <Button
                    android:id="@+id/btnIndCompSave"
                    android:layout_width="600dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="58dp"
                    android:layout_marginBottom="50dp"
                    android:textSize="35sp"
                    android:layout_gravity="center_horizontal"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/color_primary"
                    android:text="Guardar comprensión" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomIndBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIndPrevStep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="35sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/white"
                android:backgroundTint="@color/color_primary"
                android:text="Atrás" />

            <Button
                android:id="@+id/btnIndNextStep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="35sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@color/white"
                android:backgroundTint="@color/color_primary"
                android:text="Siguiente" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>