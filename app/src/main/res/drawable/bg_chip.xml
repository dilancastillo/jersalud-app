<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo transparente -->
    <solid android:color="@android:color/transparent"/>

    <!-- Bordes redondeados tipo píldora -->
    <corners android:radius="50dp"/>

    <!-- Contorno -->
    <stroke
        android:width="2dp"
        android:color="#D0D5DD"/> <!-- gris suave -->

    <!-- Espaciado interno -->
    <padding
        android:left="20dp"
        android:top="10dp"
        android:right="20dp"
        android:bottom="10dp"/>
</shape>