<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo tipo card -->
    <item>
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="20dp"/>
            <stroke
                android:width="2dp"
                android:color="#E0E0E0"/>
        </shape>
    </item>

    <!-- Tu selector con padding -->
    <item
        android:left="30dp"
        android:top="30dp"
        android:right="30dp"
        android:bottom="30dp">
        <selector>

            <!-- Seleccionado -->
            <item android:state_checked="true"
                android:drawable="@drawable/understood_selected"/>

            <!-- No seleccionado -->
            <item
                android:drawable="@drawable/understood"/>

        </selector>
    </item>

</layer-list>